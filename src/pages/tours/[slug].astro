---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header";
import PriceCalculator from "../../components/PriceCalculator";
import Contact from "../../components/Contact";
import Footer from "../../components/Footer";
import { TOURS_DATA, type TourData } from "../../data/tours";
import { getMinPrice, formatCLP } from "../../lib/pricing";
import { normalizeHref } from "../../utils/url";

export function getStaticPaths() {
  return TOURS_DATA.map((tour) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props as { tour: TourData };

const otherTours = TOURS_DATA.filter((t) => t.slug !== tour.slug);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const minPriceThousands = getMinPrice(tour.calculatorId);
const startingPrice = minPriceThousands !== null ? formatCLP(minPriceThousands) : null;
const minPriceCLP = minPriceThousands !== null ? minPriceThousands * 1000 : undefined;

const touristTrip = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: tour.title,
  description: tour.metaDescription,
  touristType: tour.touristType,
  itinerary: {
    "@type": "ItemList",
    itemListElement: tour.itinerary.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${item.time} — ${item.activity}`,
    })),
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "CLP",
    price: minPriceCLP,
    availability: "https://schema.org/InStock",
    url: canonicalUrl,
  },
  provider: {
    "@type": "TourOperator",
    name: "Wine Tours Valparaíso",
  },
};
---

<Layout
  title={`${tour.title} | Wine Tours Valparaíso`}
  description={tour.metaDescription}
  ogImage={`https://winetoursvalparaiso.com${tour.image}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(touristTrip)} />
  </Fragment>

  <div class="min-h-screen">
    <Header client:load />

    <section class="relative pt-40 pb-20 lg:pt-48 lg:pb-28 overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style={`background-image: url(${tour.image})`}
      >
        <div class="absolute inset-0 gradient-hero" />
      </div>

      <div class="relative z-10 container mx-auto px-6">
        <nav class="mb-6 text-sm font-body text-wine-cream/70" aria-label="Breadcrumb">
          <a href="/" class="hover:text-wine-cream transition-colors">Home</a>
          <span class="mx-2">/</span>
          <a href="/#experiences" class="hover:text-wine-cream transition-colors">Tours</a>
          <span class="mx-2">/</span>
          <span class="text-wine-cream">{tour.title}</span>
        </nav>

        <p class="font-body text-wine-cream/80 tracking-[0.3em] uppercase text-sm mb-4">
          {tour.subtitle}
        </p>
        <h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-wine-cream font-semibold leading-tight mb-6 max-w-3xl">
          {tour.title}
        </h1>
        {startingPrice && (
          <p
            class="group relative inline cursor-help font-display text-2xl md:text-3xl text-wine-gold font-semibold"
            tabindex="0"
            aria-label="Price disclaimer"
          >
            Prices start from {startingPrice} per person<span class="ml-1 text-3xl md:text-4xl leading-none align-middle select-none" aria-hidden="true">*</span>
            <span
              role="tooltip"
              class="pointer-events-none absolute left-0 top-full z-20 mt-3 w-72 rounded-md bg-wine-charcoal px-3 py-2 text-left font-body text-xs font-normal normal-case tracking-normal text-wine-cream opacity-0 shadow-elevated transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100"
            >
              Price may vary depending on group size and pickup/drop-off points
            </span>
          </p>
        )}
      </div>
    </section>

    <section class="py-20 lg:py-28 bg-background">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          {/* Left column — tour details */}
          <div>
            <h2 class="font-display text-2xl font-semibold text-foreground uppercase tracking-wide mb-6">
              Itinerary
            </h2>
            <div class="space-y-4">
              {tour.itinerary.map((item) => (
                <div class="flex gap-4">
                  <span class="font-body text-primary font-semibold text-sm min-w-[60px]">
                    {item.time}
                  </span>
                  <span class="font-body text-muted-foreground text-sm">
                    {item.activity}
                  </span>
                </div>
              ))}
            </div>

            <h2 class="font-display text-2xl font-semibold text-foreground uppercase tracking-wide mb-6 mt-12">
              Includes
            </h2>
            <ul class="space-y-3">
              {tour.includes.map((item) => (
                <li class="flex items-start gap-2 font-body text-muted-foreground text-sm">
                  <span class="text-primary mt-0.5">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {tour.note && (
              <p class="font-body text-xs text-muted-foreground italic mt-6">
                {tour.note}
              </p>
            )}
          </div>

          {/* Right column — price calculator */}
          <div class="lg:sticky lg:top-28">
            <PriceCalculator client:load embedded initialTourId={tour.calculatorId} />
          </div>
        </div>
      </div>
    </section>

    {tour.regionInfo && (
      <section class="py-16 lg:py-20 bg-secondary/50">
        <div class="container mx-auto px-6 max-w-3xl">
          <h2 class="font-display text-2xl font-semibold text-foreground uppercase tracking-wide mb-6">
            {tour.regionInfoHeading ?? "About the Casablanca Valley"}
          </h2>
          <div class="space-y-4">
            {tour.regionInfo.map((paragraph) => (
              <p class="font-body text-muted-foreground leading-relaxed">
                {paragraph}
              </p>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="py-16 lg:py-20 bg-background">
      <div class="container mx-auto px-6">
        <h2 class="font-display text-2xl md:text-3xl font-semibold text-foreground text-center mb-10">
          Explore Our Other Tours
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {otherTours.map((other) => (
            <a
              href={normalizeHref(`/tours/${other.slug}`)}
              class="group block bg-card rounded-lg overflow-hidden shadow-soft hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
            >
              <div class="h-36 overflow-hidden">
                <img
                  src={other.image}
                  alt={other.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-4">
                <p class="font-body text-primary text-xs tracking-[0.1em] uppercase mb-1">
                  {other.subtitle}
                </p>
                <p class="font-display text-lg font-semibold text-foreground">
                  {other.title}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Contact client:load />
    <Footer />
  </div>
</Layout>
