---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header";
import Contact from "../../components/Contact";
import Footer from "../../components/Footer";
import PhotoGallery from "../../components/PhotoGallery";
import type { GalleryPhoto } from "../../components/PhotoGallery";
import photoData from "../../data/gallery-photos.json";

const title = "Casablanca Valley Wine Tour Photos | Wine Tours Valparaíso";
const description =
  "Real photos from our wine tours: Casablanca Valley vineyards, working cellars, tastings and Valparaíso's hills. Guided by Michael since 2007.";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/gallery/*.{jpg,JPG,jpeg}",
  { eager: true }
);

// Small WebP thumbnails for the masonry, larger WebPs for the popup — the originals are
// up to ~3 MB each, so neither is ever served as-is.
const photos: GalleryPhoto[] = await Promise.all(
  photoData.map(async (p) => {
    const meta = images[`/src/assets/gallery/${p.filename}`]?.default;
    if (!meta) throw new Error(`Gallery image missing: ${p.filename}`);
    const [thumb, full] = await Promise.all([
      getImage({ src: meta, width: 480, format: "webp", quality: 72 }),
      getImage({ src: meta, width: Math.min(meta.width, 1800), format: "webp", quality: 80 }),
    ]);
    return {
      alt: p.alt,
      caption: p.caption,
      thumb: { src: thumb.src, width: Number(thumb.attributes.width), height: Number(thumb.attributes.height) },
      full: { src: full.src, width: Number(full.attributes.width), height: Number(full.attributes.height) },
    };
  })
);

const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Photos from our Casablanca Valley wine tours",
  description,
  inLanguage: "en",
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: photos.map((p) => ({
    "@type": "ImageObject",
    contentUrl: new URL(p.full.src, Astro.site).href,
    caption: p.caption,
    description: p.alt,
  })),
};

const LINK_CLASS = "text-primary underline underline-offset-2 hover:text-primary/80";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(gallerySchema)} />
  </Fragment>

  <div class="min-h-screen">
    <Header client:load alwaysScrolled />

    <section class="pt-40 pb-20 lg:pt-48 lg:pb-28 bg-background">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mb-14 font-body text-muted-foreground leading-relaxed space-y-5">
          <h1 class="font-display text-4xl md:text-5xl font-semibold text-foreground mb-8">
            Photos from Our Casablanca Valley Wine Tours
          </h1>

          <p>
            Welcome to our photo gallery. These are real pictures from our tours: the vineyards,
            cellars and colourful streets that make Chile's wine country and Valparaíso so easy to
            fall for.
          </p>
          <p>
            We've been guiding travellers since 2007 through the Casablanca Valley, and on custom
            tours through the Maipo Valley and Colchagua Valley too, as well as around the historic
            port city of Valparaíso. Here's a taste of what you'll find:
          </p>

          <ul class="list-disc pl-6 space-y-2">
            <li>Vineyards in the Chilean sun, from coastal rows of vines to the hills behind them</li>
            <li>Wine tastings with boutique family producers and well-known wineries</li>
            <li>
              Wineries you'll spot: <a href="/wineries/#bodegas-re" class={LINK_CLASS}>Bodegas RE</a>, <a href="/wineries/#catrala" class={LINK_CLASS}>Catrala</a>, <a href="/wineries/#loma-larga" class={LINK_CLASS}>Loma Larga</a>, Quintay, <a href="/wineries/#emiliana" class={LINK_CLASS}>Emiliana</a>, <a href="/wineries/#casas-del-bosque" class={LINK_CLASS}>Casas del Bosque</a>, Lapostolle and Montes </li>
            <li>Behind the scenes in the cellar, with barrels being topped up and bottles labelled by hand</li>
            <li>Valparaíso and Viña del Mar, with street art, steep hills and plenty of heritage</li>
            <li>Our guests, enjoying a relaxed day out in a small group</li>
          </ul>

          <p>
            Every photo was taken on one of our tours, so what you see here is what you'll get. If it makes you want to come along, take a look at our <a href="/tours/" class={LINK_CLASS}>Casablanca Valley wine tours</a>, or get in touch and we'll plan a route around you, including Maipo or Colchagua. </p>
        </div>

        <PhotoGallery client:load photos={photos} />
      </div>
    </section>

    <Contact client:load />
    <Footer />
  </div>
</Layout>
