---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";

const description =
  "How Wine Tours Valparaíso collects, uses and protects your information when you visit our website or send us an enquiry about a tour.";

const h2 = "font-display text-2xl font-semibold text-foreground uppercase tracking-wide mt-12 mb-4";
const p = "font-body text-muted-foreground leading-relaxed mb-4";
const ul = "list-disc pl-6 space-y-2 font-body text-muted-foreground leading-relaxed mb-4";
---

<Layout title="Privacy Policy | Wine Tours Valparaíso" description={description}>
  <div class="min-h-screen">
    <Header client:load alwaysScrolled />

    <section class="pt-40 pb-20 lg:pt-48 lg:pb-28 bg-background">
      <div
        id="privacy-policy"
        class="container mx-auto px-6 max-w-3xl [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-primary/80"
      >
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-foreground mb-8">
          Privacy Policy
        </h1>
        <p class={p}>Last updated: 05.10.2026</p>

        <h2 class={h2}>Who we are</h2>
        <p class={p}>
          Wine Tours Valparaíso ("we", "us") runs winetoursvalparaiso.com and organises guided wine and city tours from Valparaíso, Chile.
          To contact us about your data, write to <a href="mailto:info@winetoursvalparaiso.com">info@winetoursvalparaiso.com</a>.
        </p>

        <h2 class={h2}>What information we collect</h2>
        <p class={p}>
          When you send us an enquiry. If you use the contact form, we receive your first name, last name, email address, preferred date, number of guests, and your message. If you contact us by email, WhatsApp or phone, we receive whatever you choose to send us, including your contact details.
        </p>
        <p class={p}>
          When you visit the website. We use Google Analytics 4 to see how the site is used. It records things like the pages you view, the buttons or links you click (for example WhatsApp, email, phone or tour buttons), your approximate location (city or country level), and your device and browser type. It does not tell us your name. It uses cookies to recognise a returning browser.
        </p>
        <p class={p}>We do not run online payments on this website. Bookings are arranged by enquiry.</p>

        <h2 class={h2}>Why we use your information</h2>
        <ul class={ul}>
          <li>To reply to your enquiry and arrange your tour</li>
          <li>To understand how visitors use the site, so we can improve it</li>
        </ul>
        <p class={p}>We don't sell your information and we don't use it for advertising.</p>

        <h2 class={h2}>Who else handles your information</h2>
        <ul class={ul}>
          <li>Formspree processes contact form submissions on our behalf.</li>
          <li>Google provides Google Analytics.</li>
        </ul>
        <p class={p}>These providers are mainly based in the United States, so your information may be processed outside Chile.</p>

        <h2 class={h2}>How long we keep it</h2>
        <ul class={ul}>
          <li>Enquiry messages: up to 2 years after your last contact with us".</li>
          <li>Analytics data: 12 months.</li>
        </ul>

        <h2 class={h2}>Cookies</h2>
        <p class={p}>
          Google Analytics sets cookies named _ga and _ga_ followed by a code. You can block or delete cookies in your browser settings, or install Google's opt-out add-on for your browser. The site still works without them.
        </p>

        <h2 class={h2}>Your rights</h2>
        <p class={p}>You can ask us to:</p>
        <ul class={ul}>
          <li>tell you what personal information we hold about you,</li>
          <li>correct it,</li>
          <li>delete it,</li>
          <li>stop using it for a particular purpose,</li>
          <li>or give you a copy of it.</li>
        </ul>
        <p class={p}>
          Email us at <a href="mailto:info@winetoursvalparaiso.com">info@winetoursvalparaiso.com</a> and we will reply within 30 days. If you are in the European Union or United Kingdom, you may also have rights under your local data protection law, and you can contact your local data protection authority.
        </p>

        <h2 class={h2}>Changes</h2>
        <p class={p}>If we change this policy, we will update the date at the top of this page.</p>
      </div>
    </section>

    <Footer />
  </div>

  <script>
    import { trackEvent } from "../../lib/analytics";

    document
      .querySelectorAll<HTMLAnchorElement>('#privacy-policy a[href^="mailto:"]')
      .forEach((link) => {
        link.addEventListener("click", () => {
          trackEvent("email_click", { button: "email_privacy" });
        });
      });
  </script>
</Layout>
