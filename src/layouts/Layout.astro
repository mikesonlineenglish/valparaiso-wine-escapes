---
import "../index.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  twitterHandle?: string;
  /** For error/utility pages with no single real URL (e.g. 404 — GitHub Pages serves
   * 404.html flatly for any unmatched path, so a self-referencing canonical would be
   * wrong). Skips the canonical tag and sets robots to noindex. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "https://winetoursvalparaiso.com/wtv-og.png",
  ogType = "website",
  twitterHandle = "@winetoursvalpo",
  noindex = false,
} = Astro.props;

// Self-referencing canonical, derived from the site config + the actual route being
// rendered — never a hardcoded string, so it can't drift from what's actually served.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Wine Tours Valparaíso" />
    <meta
      name="keywords"
      content="wine tours, Valparaiso, Chile, Casablanca Valley, wine tasting, vineyard tours, Chilean wine"
    />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wine Tours Valparaíso" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wine Tours Valparaíso - Premium Chilean Wine Experiences" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO -->
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Prerender.io verification - configure middleware at your CDN/hosting level -->
    <meta name="prerender-status-code" content="200" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SSGXVTTWHZ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-SSGXVTTWHZ");
    </script>

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
